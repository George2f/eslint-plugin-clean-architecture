{
  "name": "@george2f/eslint-plugin-clean-architecture",
  "version": "0.1.1",
  "description": "Configurable architectural checks derived from Robert C. Martin's Clean Architecture",
  "type": "module",
  "license": "MIT",
  "author": "Juraj Pejnovic",
  "repository": { "type": "git", "url": "git+https://github.com/George2f/eslint-plugin-clean-architecture.git" },
  "homepage": "https://github.com/George2f/eslint-plugin-clean-architecture#readme",
  "bugs": { "url": "https://github.com/George2f/eslint-plugin-clean-architecture/issues" },
  "keywords": ["eslint", "eslintplugin", "clean-architecture", "architecture", "solid", "boundaries", "dependency-rule"],
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "engines": { "node": "^18.18.0 || ^20.9.0 || >=21.1.0" },
  "files": ["dist", "docs", "CHANGELOG.md", "LICENSE"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./rules.json": "./dist/rules.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs && node scripts/generate-catalog.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "npm run typecheck && npm run build && eslint . --no-cache --max-warnings 0",
    "verify:dist": "node scripts/verify-dist.mjs",
    "example": "eslint --config examples/basic/eslint.config.mjs examples/basic/src --no-cache --max-warnings 0",
    "prepublishOnly": "npm run lint && npm test && npm run verify:dist"
  },
  "peerDependencies": { "eslint": "^8.57.0 || ^9.0.0 || ^10.0.0" },
  "dependencies": { "minimatch": "^9.0.5", "typescript": "^5.9.3" },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/rule-tester": "^8.0.0",
    "@typescript-eslint/utils": "^8.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
