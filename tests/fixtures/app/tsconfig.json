{
  "compilerOptions": {
    "strict": true, "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "allowJs": true, "skipLibCheck": true, "noEmit": true,
    "baseUrl": ".", "paths": { "@domain/*": ["src/domain/*"], "@adapters/*": ["src/adapters/*"] }
  },
  "include": ["src/**/*"]
}
